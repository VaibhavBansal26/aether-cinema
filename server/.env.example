# JDBC URL (not postgres://). Credentials are separate to avoid accidental URL logging.
DATABASE_URL=jdbc:postgresql://localhost:5432/aether?sslmode=require
DATABASE_USERNAME=aether_app
DATABASE_PASSWORD=
DB_POOL_SIZE=20
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_CINEMA=
STRIPE_PRICE_COLLECTIVE=
APP_ORIGIN=
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=
CF_CUSTOMER_CODE=
PORT=8080

# Optional private Python recommendation service. Leave unset for editorial fallback.
RECOMMENDER_URL=
RECOMMENDER_SERVICE_TOKEN=

# Infrastructure (apply migration 003 before starting updated API)
REDIS_URL=redis://localhost:6379
RECOMMENDATION_CACHE_ENABLED=false
WORKER_ENABLED=false
# Production: SPRING_PROFILES_ACTIVE=production, managed Redis TLS rediss:// URL,
# DB_POOL_SIZE=10; DATABASE_URL must use sslmode=verify-full and trusted CA.
